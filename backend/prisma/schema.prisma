generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MEMBER
}

enum DomainOwnership {
  FAMILY_OWNED
  MANAGED_BY_FAMILYHUB
}

enum DomainStatus {
  PENDING_SETUP
  PURCHASED
  DNS_CONFIGURED
  SSL_ENABLED
  LIVE
  FAILED
}

enum SSLStatus {
  PENDING
  ACTIVE
  FAILED
}

enum VerificationMethod {
  TXT
  CNAME
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum PurchaseStatus {
  NOT_APPLICABLE
  SEARCHING
  AVAILABLE
  UNAVAILABLE
  PURCHASING
  PURCHASED
  FAILED
}

enum RenewalStatus {
  NONE
  ACTIVE
  MANUAL_REQUIRED
  FAILED
}

enum WorkflowStep {
  REQUEST_SUBMITTED
  PENDING_SETUP
  SEARCHING_DOMAIN
  DOMAIN_PURCHASED
  DNS_CONFIGURATION
  DNS_VERIFICATION
  SSL_GENERATION
  TENANT_MAPPING
  WEBSITE_LIVE
}

enum WorkflowStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

enum ContactType {
  OWNER
  TECHNICAL
  BILLING
  SUPPORT
}

enum EventSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum MemberStatus {
  PENDING_INVITE
  INVITATION_SENT
  EMAIL_FAILED
  OTP_VERIFIED
  PROFILE_INCOMPLETE
  ACTIVE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model User {
  id              String   @id @default(cuid())
  memberId        String?  @unique
  firstName       String
  lastName        String
  email           String?  @unique
  phone           String?  @unique
  password        String?  
  role            Role     @default(MEMBER)
  familyId        String?
  gender          String?
  relationship    String?
  familyBranch    String?
  fatherId        String?
  motherId        String?
  spouseId        String?
  notes           String?
  status          MemberStatus @default(ACTIVE)
  
  avatar          String?
  isActive        Boolean  @default(true)
  profileCompletion Int @default(25)
  currentProfileStep String @default("Basic Information")
  isProfileCompleted Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  isTemporaryPassword Boolean @default(false)
  mustChangePassword  Boolean @default(false)

  brevoErrorCode    String?
  brevoErrorMessage String?
  lastEmailAttempt  DateTime?

  family          Family?  @relation(fields: [familyId], references: [id])
  memberProfile   MemberProfile?
  memberSettings  MemberSettings?
  invitation      Invitation?
  documents       Document[]
  announcements   Announcement[]
  polls           Poll[] @relation("UserPolls")
  
  groupMembers    GroupMember[]
  groupMessages   GroupMessage[]
  sentMessages    Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  familyHistories FamilyHistory[]
  googleCalendar  GoogleCalendarConnection?

  groupPosts      GroupPost[]
  groupComments   GroupPostComment[]
  groupLikes      GroupPostLike[]

  familyAdmins    FamilyAdmin[]

  @@index([familyId])
  @@map("users")
}

model Family {
  id              String   @id @default(cuid())
  name            String
  familyCode      String?  @unique
  customDomain    String?  @unique
  logo            String?
  coverImage      String?
  bannerImage     String?
  themeColor      String?
  primaryColor    String?
  secondaryColor  String?
  description     String?  @db.Text
  about           String?  @db.Text
  history         String?  @db.Text
  contactEmail    String?
  contactPhone    String?
  facebook        String?
  youtube         String?
  instagram       String?
  twitter         String?
  linkedin        String?
  website         String?
  subscription    String?

  familyHead      String?
  plan            String?  @default("Free")
  status          String?  @default("Active")
  address         String?
  city            String?
  state           String?
  country         String?
  
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members         User[]
  admins          FamilyAdmin[]
  events          Event[]         @relation("FamilyEvents")
  documents       Document[]      @relation("FamilyDocuments")
  announcements   Announcement[]  @relation("FamilyAnnouncements")
  polls           Poll[]          @relation("FamilyPolls")
  notifications   Notification[]  @relation("FamilyNotifications")
  groups          Group[]         @relation("FamilyGroups")
  familyHistories FamilyHistory[] @relation("FamilyHistories")
  googleCalendarConnections GoogleCalendarConnection[] @relation("FamilyGoogleCalendar")
  feeds           FamilyFeed[]    @relation("FamilyFeeds")
  domains         FamilyDomain[]
  contacts        DomainContact[]

  @@map("families")
}

model MemberProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  dob               DateTime?
  bloodGroup        String?
  address           String?
  education         String?
  occupation        String?
  company           String?
  biography         String?
  socialLinks       Json?
  emergency         Json?
  documents         Json?
  privacySettings   Json?
  currentStage      Int       @default(1)
  profileCompletion Int       @default(0)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id        String       @id @default(cuid())
  userId    String       @unique
  token     String       @unique
  otp       String?
  expiresAt DateTime
  status    InviteStatus @default(PENDING)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id                String    @id @default(cuid())
  eventId           String?   @unique
  name              String
  category          String
  description       String
  bannerImage       String?
  eventDate         DateTime
  startTime         String
  endTime           String?
  venue             String
  address           String
  city              String
  state             String
  country           String
  googleMapsUrl     String?
  organizerId       String
  familyBranch      String
  visibility        String    @default("Private")
  inviteType        String    @default("All Members")
  invitedMembers    Json?
  rsvpEnabled       Boolean   @default(false)
  maxGuests         Int?
  rsvpDeadline      DateTime?
  liveStream        Boolean   @default(false)
  streamVisibility  String?
  liveChat          Boolean   @default(false)
  recordEvent       Boolean   @default(false)
  allowPhotos       Boolean   @default(true)
  allowComments     Boolean   @default(true)
  reminders         Json?
  status            String    @default("Draft")
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  familyId          String?
  streamingPlatform String?
  recordedUrl       String?
  streamId          String?   @unique
  streamLink        String?
  streamStatus      String    @default("OFFLINE")
  family            Family?   @relation("FamilyEvents", fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([eventDate])
  @@map("events")
}

model Document {
  id         String             @id @default(cuid())
  name       String
  type       String
  size       String
  category   String
  url        String
  status     DocumentStatus     @default(PENDING)
  visibility DocumentVisibility @default(PRIVATE)
  uploaderId String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  familyId   String?
  family     Family?            @relation("FamilyDocuments", fields: [familyId], references: [id], onDelete: Cascade)
  uploader   User               @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([createdAt])
  @@map("documents")
}

model MemberSettings {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  profile_photo              String?
  display_name               String?
  username                   String?  @unique
  email                      String?
  mobile                     String?
  theme                      String   @default("System")
  language                   String   @default("English")
  timezone                   String   @default("UTC")
  show_mobile                Boolean  @default(false)
  show_email                 Boolean  @default(false)
  show_dob                   Boolean  @default(false)
  show_address               Boolean  @default(false)
  show_public_profile        Boolean  @default(true)
  allow_direct_messages      Boolean  @default(true)
  email_notifications        Boolean  @default(true)
  whatsapp_notifications     Boolean  @default(true)
  push_notifications         Boolean  @default(true)
  birthday_notifications     Boolean  @default(true)
  event_notifications        Boolean  @default(true)
  announcement_notifications Boolean  @default(true)
  two_factor_enabled         Boolean  @default(false)
  updated_at                 DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member_settings")
}

model Announcement {
  id         String   @id @default(cuid())
  title      String
  message    String
  targetType String   @default("All Members")
  pinned     Boolean  @default(false)
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  familyId   String?
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  family     Family?  @relation("FamilyAnnouncements", fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([createdAt])
  @@map("announcements")
}

model Poll {
  id        String   @id @default(cuid())
  question  String
  options   Json
  votes     Json
  endDate   DateTime
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  familyId  String?
  author    User     @relation("UserPolls", fields: [authorId], references: [id], onDelete: Cascade)
  family    Family?  @relation("FamilyPolls", fields: [familyId], references: [id], onDelete: Cascade)

  @@map("polls")
}

model Notification {
  id         String   @id @default(cuid())
  title      String
  message    String
  type       String   @default("system")
  targetType String   @default("All")
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  familyId   String?
  family     Family?  @relation("FamilyNotifications", fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([createdAt])
  @@map("notifications")
}

model Group {
  id             String         @id @default(cuid())
  name           String
  description    String?
  category       String         @default("Immediate Family")
  coverImage     String?
  icon           String?
  privacy        String         @default("Private")
  status         String         @default("Active")
  allowInvites   Boolean        @default(true)
  allowPosts     Boolean        @default(true)
  allowFiles     Boolean        @default(true)
  allowPhotos    Boolean        @default(true)
  allowVideos    Boolean        @default(true)
  allowPolls     Boolean        @default(true)
  welcomeMessage String?
  ownerId        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  familyId       String?
  members        GroupMember[]
  messages       GroupMessage[]
  posts          GroupPost[]
  family         Family?        @relation("FamilyGroups", fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("groups")
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("Member")
  status   String   @default("Active")
  isMuted  Boolean  @default(false)
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  senderId  String
  type      String   @default("Text")
  content   String
  fileUrl   String?
  fileName  String?
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([createdAt])
  @@map("group_messages")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  text       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  fileName   String?
  fileUrl    String?
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("messages")
}

model FamilyHistory {
  id             String   @id @default(cuid())
  title          String
  description    String?
  category       String
  eventDate      DateTime
  location       String?
  visibility     String   @default("Family Only")
  status         String   @default("Published")
  thumbnailUrl   String?
  addedById      String
  relatedMembers Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  familyId       String?
  addedBy        User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  family         Family?  @relation("FamilyHistories", fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("family_history")
}

model GoogleCalendarConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  familyId     String?
  googleEmail  String
  accessToken  String
  refreshToken String?
  expiryDate   BigInt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  family       Family?  @relation("FamilyGoogleCalendar", fields: [familyId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
}

model GroupPost {
  id          String             @id @default(cuid())
  groupId     String
  authorId    String
  content     String
  attachments Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  comments    GroupPostComment[]
  likes       GroupPostLike[]
  author      User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  group       Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("group_posts")
}

model GroupPostComment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("group_post_comments")
}

model GroupPostLike {
  id        String    @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime  @default(now())
  post      GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("group_post_likes")
}

model EmailQueue {
  id           String    @id @default(cuid())
  recipient    String
  subject      String
  template     String?
  payload      Json?
  status       String    @default("PENDING")
  attempts     Int       @default(0)
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("email_queue")
}

model AuditLog {
  id        String   @id @default(cuid())
  user      String
  action    String
  module    String
  details   String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model SupportTicket {
  id        String   @id @default(cuid())
  family    String
  subject   String
  priority  String   @default("Medium")
  status    String   @default("Open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_tickets")
}

model Transaction {
  id        String   @id @default(cuid())
  family    String
  plan      String
  amount    Float
  status    String   @default("Paid")
  createdAt DateTime @default(now())

  @@map("transactions")
}

model FamilyFeed {
  id          String   @id @default(cuid())
  familyId    String
  type        String
  title       String?
  description String?
  image       String?
  video       String?
  referenceId String?
  createdBy   String?
  visibility  String   @default("PUBLIC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  family      Family   @relation("FamilyFeeds", fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([createdAt])
  @@map("family_feeds")
}

model FamilyDomain {
  id                  String             @id @default(cuid())
  familyId            String
  domainName          String             @unique
  ownership           DomainOwnership    @default(FAMILY_OWNED)
  registrar           String?
  dnsProvider         String?
  purchasePrice       Float?
  renewalPrice        Float?
  expiryDate          DateTime?
  autoRenew           Boolean            @default(false)
  
  verificationToken   String?            @unique
  verificationMethod  VerificationMethod @default(TXT)
  verificationStatus  VerificationStatus @default(UNVERIFIED)

  dnsVerified         Boolean            @default(false)
  sslStatus           SSLStatus          @default(PENDING)
  sslIssuedAt         DateTime?
  sslExpiresAt        DateTime?
  sslRenewalDate      DateTime?

  purchaseStatus      PurchaseStatus     @default(NOT_APPLICABLE)
  renewalStatus       RenewalStatus      @default(NONE)
  registrationYears   Int                @default(1)
  purchaseDate        DateTime?

  domainStatus        DomainStatus       @default(PENDING_SETUP)
  migrationRequired   Boolean            @default(false)
  notes               String?            @db.Text

  connectedAt         DateTime?
  verifiedAt          DateTime?
  nameservers         Json?
  dnsInstructions     String?            @db.Text
  
  createdBy           String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  
  family              Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  histories           DomainHistory[]
  contacts            DomainContact[]
  dnsRecords          DomainDnsRecord[]
  workflows           DomainWorkflow[]
  events              DomainEvent[]
  
  @@index([familyId])
  @@index([domainName])
  @@index([domainStatus])
  @@index([deletedAt])
  @@map("family_domains")
}

model DomainHistory {
  id             String       @id @default(cuid())
  familyDomainId String
  status         DomainStatus
  updatedBy      String?
  notes          String?
  createdAt      DateTime     @default(now())
  familyDomain   FamilyDomain @relation(fields: [familyDomainId], references: [id], onDelete: Cascade)

  @@index([familyDomainId])
  @@map("domain_history")
}

model FamilyAdmin {
  id          String    @id @default(cuid())
  familyId    String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([familyId])
  @@index([userId])
  @@map("family_admins")
}

model DomainContact {
  id          String       @id @default(cuid())
  domainId    String
  domain      FamilyDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  familyId    String
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  contactType ContactType  @default(OWNER)
  name        String
  email       String
  phone       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([domainId])
  @@index([familyId])
  @@map("domain_contacts")
}

model DomainDnsRecord {
  id            String       @id @default(cuid())
  domainId      String
  domain        FamilyDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  recordType    String       // TXT, CNAME, A
  recordName    String       // familyhub-verification or @
  expectedValue String       @db.Text
  actualValue   String?      @db.Text
  isVerified    Boolean      @default(false)
  ttl           Int          @default(300)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([domainId])
  @@map("domain_dns_records")
}

model DomainWorkflow {
  id          String             @id @default(cuid())
  domainId    String
  domain      FamilyDomain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  step        WorkflowStep
  status      WorkflowStepStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  completedBy String?
  remarks     String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([domainId, step])
  @@index([domainId])
  @@map("domain_workflow")
}

model DomainEvent {
  id          String        @id @default(cuid())
  domainId    String
  domain      FamilyDomain  @relation(fields: [domainId], references: [id], onDelete: Cascade)
  eventType   String        // FAMILY_CREATED, ADMIN_CREATED, DOMAIN_CREATED, VERIFICATION_GENERATED, VERIFICATION_SUCCESS, VERIFICATION_FAILED, SSL_GENERATED, SSL_FAILED, DOMAIN_PURCHASED, RENEWED, TRANSFERRED, WEBSITE_ACTIVATED
  severity    EventSeverity @default(INFO)
  message     String        @db.Text
  metadata    Json?
  triggeredBy String?
  createdAt   DateTime      @default(now())

  @@index([domainId])
  @@index([eventType])
  @@map("domain_events")
}


