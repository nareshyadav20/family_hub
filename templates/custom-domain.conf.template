server {
    listen 80;
    server_name __DOMAIN__;

    # Certbot webroot for HTTP-01 challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect all other HTTP traffic to HTTPS (if you want SSL termination on Nginx)
    location / {
        # proxy_pass http://127.0.0.1:5173; # (if you're terminating here initially)
        # return 301 https://$host$request_uri;
        
        # NOTE: For initial provisioning before Certbot succeeds, we just proxy to the frontend.
        proxy_pass http://127.0.0.1:5173;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# The HTTPS block will be injected by Certbot via `--nginx` or you can manually define it here 
# if you are managing the SSL paths yourself. Certbot often handles it automatically when you 
# run `certbot --nginx`. But in our script we used `--webroot`. If using `--webroot`, you should
# have a secondary template or let Certbot do it. 
